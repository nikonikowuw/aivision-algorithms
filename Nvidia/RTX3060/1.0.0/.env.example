# ============================================================
# GPU Face Recognition Algorithm Package — Environment Config
# ============================================================
# Copy this file to .env and adjust values for your deployment.
# .env is loaded at runtime and overridden by config_json parameters.

# ---- Model Paths (relative to package_dir) ----
yolo11n_engine_path=weights/yolo11n.engine
retinaface_engine_path=weights/retinaface.engine
adaface_ir50_engine_path=weights/adaface_ir50.engine

# ---- Detection Thresholds ----
person_conf_thres=0.45
face_conf_thres=0.55
recognition_threshold=0.45

# ---- NMS Parameters ----
nms_iou_thres=0.45

# ---- Tracker Parameters ----
enable_tracker=true
tracker_iou_thres=0.30
tracker_max_lost_frames=30

# ---- Batch Scheduling ----
max_batch_size=16
batch_timeout_ms=8
max_persons=50
max_faces=50

# ---- CUDA / TensorRT ----
cuda_device_id=0
trt_max_workspace_size=2147483648

# ---- Logging (per-module level overrides) ----
# log_level_config=INFO
# log_level_backend=INFO
# log_level_person_det=INFO
# log_level_face_det=INFO
# log_level_face_rec=INFO
# log_level_tracker=INFO
# log_level_face_index=INFO
# log_level_aligner=INFO
# log_level_image_util=INFO
# log_level_pipeline=INFO
# log_level_app=INFO

# ---- Timing & Debug ----
enable_timing_report=true
log_timing_interval=100
log_model_io=false
