# Smoking Detection 1.0.0 - Default Configuration
# This file is optional; values here are overridden by config_json in detector_init.

# 推理后端: coreml_native | ort_coreml
backend=coreml_native

# 分析帧率
analysis_fps=4

# 人体检测
max_persons=10
person_conf_threshold=0.50
person_nms_threshold=0.70

# 香烟检测
cigarette_conf_threshold=0.60
cigarette_nms_threshold=0.70

# 分块检测
tile_enabled=true
tile_grid_rows=2
tile_grid_cols=2
tile_overlap=0.15
tile_budget_per_tick=2

# 人物上部 ROI
upper_body_ratio=0.60
roi_expand_x=0.15
roi_expand_top=0.05

# 时序状态机
temporal_window=5
confirm_hits=3
rearm_ms=2000

# 跟踪器
tracker_iou_threshold=0.20
tracker_max_lost_ms=2000

# 日志级别 (0=warn, 1=info, 2=debug)
log_level=0
